#!/bin/bash

OS="$(uname -s)"
REFRESH_INTERVAL=${1:-2}

WHITE='\033[0;37m'
YELLOW='\033[1;33m'
BLACK='\033[0;30m'
RED='\033[0;31m'
BG_RED='\033[41m'
NC='\033[0m'

get_color() {
    local value=$1
    if (( $(echo "$value < 30" | bc -l 2>/dev/null || echo 0) )); then
        echo "WHITE"
    elif (( $(echo "$value < 80" | bc -l 2>/dev/null || echo 0) )); then
        echo "YELLOW"
    elif (( $(echo "$value < 95" | bc -l 2>/dev/null || echo 0) )); then
        echo "BLACK"
    else
        echo "RED"
    fi
}

print_colored() {
    local label=$1
    local value=$2
    local color_name=$(get_color $value)
    
    case $color_name in
        WHITE)
            color_var="$WHITE"
            ;;
        YELLOW)
            color_var="$YELLOW"
            ;;
        BLACK)
            color_var="$BLACK"
            ;;
        RED)
            color_var="${RED}${BG_RED}"
            ;;
        *)
            color_var="$WHITE"
            ;;
    esac
    
    printf "%-15s: ${color_var}%6.2f%%${NC}\n" "$label" "$value"
}

get_cpu_usage() {
    if [[ "$OS" == "Darwin" ]]; then
        top -l 2 -n 0 2>/dev/null | grep "CPU usage" | tail -1 | awk '{print $7}' | sed 's/%//'
    else
        top -bn2 2>/dev/null | grep "Cpu(s)" | tail -1 | awk -F'[, ]+' '{print 100 - $8}'
    fi
}

get_mem_usage() {
    if [[ "$OS" == "Darwin" ]]; then
        mem_free=$(vm_stat 2>/dev/null | grep "Pages free:" | awk '{print $3}' | sed 's/\.//')
        mem_active=$(vm_stat 2>/dev/null | grep "Pages active:" | awk '{print $3}' | sed 's/\.//')
        mem_inactive=$(vm_stat 2>/dev/null | grep "Pages inactive:" | awk '{print $3}' | sed 's/\.//')
        mem_wired=$(vm_stat 2>/dev/null | grep "Pages wired down:" | awk '{print $4}' | sed 's/\.//')
        mem_compressor=$(vm_stat 2>/dev/null | grep "Pages occupied by compressor:" | awk '{print $5}' | sed 's/\.//')
        
        total_mem=$(( mem_free + mem_active + mem_inactive + mem_wired + mem_compressor ))
        used_mem=$(( mem_active + mem_wired + mem_compressor ))
        
        if [ $total_mem -gt 0 ]; then
            echo "scale=2; $used_mem * 100 / $total_mem" | bc 2>/dev/null || echo "0"
        else
            echo "0"
        fi
    else
        free 2>/dev/null | grep Mem | awk '{printf "%.2f", $3/$2 * 100}'
    fi
}

get_network_interfaces() {
    if [[ "$OS" == "Darwin" ]]; then
        ifconfig -l 2>/dev/null | tr ' ' '\n' | grep -E '^(en|eth|wlan|bond|bridge)' | sort
    else
        ip -br link 2>/dev/null | awk '{print $1}' | grep -E '^(en|eth|wlan|bond|bridge)' | sort
    fi
}

get_disk_io_usage() {
    if [[ "$OS" == "Darwin" ]]; then
        iostat 1 2 2>/dev/null | tail -1 | awk '{printf "%.2f", ($3 + $4) / 10}'
    else
        iostat -d -x 1 2 2>/dev/null | grep -v '^$' | tail -n +3 | awk '{util+=$14} END {printf "%.2f", util/NR}'
    fi
}

restore_terminal() {
    tput cnorm
    echo -e "${NC}\n\nMonitoring stopped. Thank you!"
    exit 0
}

trap restore_terminal INT TERM EXIT

clear
echo "Initializing monitoring data..."

interfaces=$(get_network_interfaces)
first_run=1

tput civis
tput clear
tput sc

cpu_usage=$(get_cpu_usage)
mem_usage=$(get_mem_usage)
disk_io=$(get_disk_io_usage)

while true; do

    for iface in $interfaces; do
        if [[ "$OS" == "Darwin" ]]; then
            rx_bytes=$(netstat -ib 2>/dev/null | grep "^$iface" | head -1 | awk '{print $7}')
            tx_bytes=$(netstat -ib 2>/dev/null | grep "^$iface" | head -1 | awk '{print $10}')
        else
            rx_bytes=$(cat /sys/class/net/$iface/statistics/rx_bytes 2>/dev/null || echo 0)
            tx_bytes=$(cat /sys/class/net/$iface/statistics/tx_bytes 2>/dev/null || echo 0)
        fi

        [ -z "$rx_bytes" ] && rx_bytes=0
        [ -z "$tx_bytes" ] && tx_bytes=0
        [ "$rx_bytes" -lt 0 ] 2>/dev/null && rx_bytes=0
        [ "$tx_bytes" -lt 0 ] 2>/dev/null && tx_bytes=0

        prev_rx_var="prev_rx_${iface//[^a-zA-Z0-9]/_}"
        prev_tx_var="prev_tx_${iface//[^a-zA-Z0-9]/_}"
        speed_var="speed_${iface//[^a-zA-Z0-9]/_}"

        prev_rx_val=$(eval "echo \$$prev_rx_var")
        prev_tx_val=$(eval "echo \$$prev_tx_var")

        if [ $first_run -eq 0 ] && [ -n "$prev_rx_val" ] && [ "$prev_rx_val" -gt 0 ] 2>/dev/null; then
            time_diff=$REFRESH_INTERVAL
            
            rx_diff=0
            [ "$rx_bytes" -ge "$prev_rx_val" ] 2>/dev/null && rx_diff=$(( rx_bytes - prev_rx_val ))
            
            tx_diff=0
            [ "$tx_bytes" -ge "$prev_tx_val" ] 2>/dev/null && tx_diff=$(( tx_bytes - prev_tx_val ))

            max_diff=$(( 1024 * 1024 * 100 ))
            [ "$rx_diff" -gt "$max_diff" ] 2>/dev/null && rx_diff=0
            [ "$tx_diff" -gt "$max_diff" ] 2>/dev/null && tx_diff=0

            rx_speed_kb=$(echo "scale=2; $rx_diff / $time_diff / 1024" | bc 2>/dev/null || echo 0)
            tx_speed_kb=$(echo "scale=2; $tx_diff / $time_diff / 1024" | bc 2>/dev/null || echo 0)

            if (( $(echo "$rx_speed_kb >= 1024" | bc -l 2>/dev/null || echo 0) )); then
                rx_speed=$(echo "scale=2; $rx_speed_kb / 1024" | bc)MB/s
            else
                rx_speed="${rx_speed_kb}KB/s"
            fi

            if (( $(echo "$tx_speed_kb >= 1024" | bc -l 2>/dev/null || echo 0) )); then
                tx_speed=$(echo "scale=2; $tx_speed_kb / 1024" | bc)MB/s
            else
                tx_speed="${tx_speed_kb}KB/s"
            fi

            usage_val=$(echo "scale=2; ($rx_speed_kb + $tx_speed_kb) / 10" | bc 2>/dev/null || echo 0)
            (( $(echo "$usage_val > 100" | bc -l 2>/dev/null || echo 0) )) && usage_val=100
            color_name=$(get_color $usage_val)
        else
            rx_speed="--.--KB/s"
            tx_speed="--.--KB/s"
            color_name="WHITE"
        fi

        eval "${prev_rx_var}=$rx_bytes"
        eval "${prev_tx_var}=$tx_bytes"
        eval "rx_speed_${iface//[^a-zA-Z0-9]/_}='${rx_speed}'"
        eval "tx_speed_${iface//[^a-zA-Z0-9]/_}='${tx_speed}'"
        eval "color_${iface//[^a-zA-Z0-9]/_}='${color_name}'"
    done

    first_run=0

    tput rc
    tput ed

    echo "================================================"
    echo "       SYSTEM RESOURCE MONITOR"
    echo "------------------------------------------------"
    echo "  OS: $OS  |  Refresh: ${REFRESH_INTERVAL}s"
    echo "  Time: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "================================================"
    echo ""
    echo "[ SYSTEM USAGE ]"
    echo "------------------------------------------------"
    
    print_colored "CPU Usage" "$cpu_usage"
    print_colored "Memory Usage" "$mem_usage"
    print_colored "Disk I/O" "$disk_io"
    
    echo ""
    echo "[ NETWORK BANDWIDTH BY INTERFACE ]"
    echo "------------------------------------------------"
    printf "%-12s %12s %12s\n" "Interface" "Download" "Upload"
    echo "------------------------------------------------"

    for iface in $interfaces; do
        rx_speed=$(eval "echo \$rx_speed_${iface//[^a-zA-Z0-9]/_}")
        tx_speed=$(eval "echo \$tx_speed_${iface//[^a-zA-Z0-9]/_}")
        color_name=$(eval "echo \$color_${iface//[^a-zA-Z0-9]/_}")
        
        case $color_name in
            WHITE) color_var="$WHITE" ;;
            YELLOW) color_var="$YELLOW" ;;
            BLACK) color_var="$BLACK" ;;
            RED) color_var="${RED}${BG_RED}" ;;
            *) color_var="$WHITE" ;;
        esac
        
        printf "${color_var}%-12s %12s %12s${NC}\n" "$iface" "$rx_speed" "$tx_speed"
    done

    echo ""
    echo "================================================"
    echo "[ COLOR LEGEND ]"
    echo -e "  ${WHITE}White${NC}: < 30%  |  ${YELLOW}Yellow${NC}: 30-80%"
    echo -e "  ${BLACK}Black${NC}: 80-95% |  ${RED}${BG_RED}Red Alert${NC}: 95-100%"
    echo "================================================"
    printf "  Press Ctrl+C to exit monitoring"
    tput el

    sleep $REFRESH_INTERVAL

    cpu_usage=$(get_cpu_usage)
    mem_usage=$(get_mem_usage)
    disk_io=$(get_disk_io_usage)
done
