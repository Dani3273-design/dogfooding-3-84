#!/bin/bash

OS="$(uname -s)"

echo "Detecting OS: $OS"
echo ""

if [[ "$OS" == "Darwin" ]]; then
    echo "Checking macOS environment..."
    if ! command -v brew &> /dev/null; then
        echo "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
    echo "Installing required tools..."
    brew install coreutils sysstat ifstat
elif [[ "$OS" == "Linux" ]]; then
    echo "Checking Ubuntu/Debian environment..."
    if command -v apt-get &> /dev/null; then
        echo "Updating package list..."
        sudo apt-get update
        echo "Installing required tools..."
        sudo apt-get install -y sysstat ifstat net-tools coreutils
    else
        echo "Unsupported Linux distribution. Please install manually: sysstat, ifstat, net-tools, coreutils"
        exit 1
    fi
else
    echo "Unsupported operating system: $OS"
    exit 1
fi

echo ""
echo "Installation completed!"
echo "Usage: bash main.shell [refresh_interval_seconds]"
